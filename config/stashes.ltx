; Stashes (docs/STASHES.md, M5f). Anomaly 1.5.3: treasure_manager.script (half the boxes filled unmarked, the kind / tier fill,
; reveal of an empty box with a map spot), ui_pda_npc_tab.script (stash messages on the dead), xr_effects.reward_stash (50%).
; Every FormID below is a Skyrim.esm record checked in the master (EDID and value, Oct 18 2026). Distances in Skyrim units.
;
; Difficulty (T21, docs/DIFFICULTY.md): {economy+} = value x Diff(Economy); untagged keys are design values, not balance.

[stashes]
enabled          = true
kinds            = wilderness, fort, bandit_camp, forsworn_camp, military_camp, dungeon, crypt, dwarven_ruin, mine, animal_den, giant_camp, shipwreck, mill, dragon_priest_lair
spots_per_place  = 1
offset           = 400, 1200   ; a spot lies this far from its place
max_spots        = 900         ; cap over every worldspace
hidden_share     = 0.5         ; filled and unmarked at a new game (Anomaly: half the boxes)
reveal_radius    = 60000       ; a note or a reward reveals a stash this close to where it happened (Anomaly spawn_local)
reveal_min       = 1500        ; ... but not right where the player stands
place_radius     = 5000        ; the container is placed when the player comes this close
marker_slots     = 8           ; marked stashes on the map at once (ALifeStashes objectives); the oldest gives its marker up

[notes]
chance           = 0.15        ; a member of a human faction carries a stash note when it dies (Anomaly stash_chance x PDA factor)

[reward]
chance           = 0.5         ; a job done pays with a stash (xr_effects.reward_stash)
replace_gold     = true        ; the stash replaces the gold (false: on top of it, as Anomaly)
budget_per_gold  = 1.0         ; {economy+} the reward stash is worth at least the gold x this (the gold already carries Diff(Economy))

[loot]
budget           = 250, 500    ; {economy+} gold value of a stash at level 0 (Anomaly: weight 500-800)
per_level        = 0.04        ; {economy+} + this share per player level
tier_levels      = 1, 8, 16, 26, 36    ; player level a tier opens at
tier_chance      = 1, 0.8, 0.75, 0.6, 0.5   ; Anomaly chance_multi
tier_count       = 1, 1.25, 1.5, 2, 3      ; Anomaly impact: count x this
gold_form        = F           ; Gold001: what is left of the budget goes in as coins
kinds            = potions, arrows, gems, soulgems, metal, scrolls, lockpicks

