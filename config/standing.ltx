; Standing: how Skyrim's people regard the player (docs/STANDING.md). Anomaly's relation registry, with Skyrim's reasons.
; Attitude runs -3000..+3000. Tiers: <= -1000 hostile (attacks on sight), <= -300 unfriendly, < +300 neutral, < +1000 friendly,
; >= +1000 allied. NOTHING starts hostile by decree: a fresh traveller is at worst unfriendly. Hostility is earned or chosen.
;
; attitude = [base] + the [rule.*] entries that hold for this player + earned goodwill + the squad's own memory.

; ---- how each faction sees an unremarkable stranger
[base]
imperial    = 80       ; the Legion is orderly and courteous to travellers who keep the peace
stormcloak  = 60       ; Ulfric's men are hospitable to Nords and wary of the rest (see the race rules)
thalmor     = -350     ; cold, suspicious, contemptuous: unfriendly to everyone who is not their own
bandit      = -650     ; outlaws take what they can from travellers, but they are cowards: the odds decide
forsworn    = -750     ; the Reach is at war with outsiders; they defend it rather than hunt on the roads
silverhand  = -600     ; zealous werewolf hunters: dangerous to lycanthropes, merely hostile-minded to the rest
necromancer = -600     ; reclusive; they kill intruders at their work, they do not stalk the roads
vampire     = -750     ; predators of the night
dawnguard   = 150      ; vampire hunters; friendly to the living
vigilant    = 0        ; Stendarr's zealots: polite until you are something they hunt
wanderer    = 220      ; adventurers and travellers look out for one another
hunter      = 180      ; woodsfolk
mercenary   = 60       ; sellswords: pragmatic, owe you nothing
mage        = 120      ; travelling scholars and College mages: curious, open
caravan     = 200      ; Khajiit merchants: courteous to anyone whose coin is good; wary of those who have robbed a caravan

; boldness of outlaws: how readily they attack when they think they hold the advantage (0..1)
[opportunism]
bandit      = 1.0
forsworn    = 0.25
silverhand  = 0.5
necromancer = 0.15
vampire     = 0.8

; how fiercely a faction defends the ground it holds against anyone it dislikes (0..1)
[territorial]
bandit      = 0.7
forsworn    = 0.95
silverhand  = 0.5
necromancer = 0.9
vampire     = 0.7
imperial    = 0.6      ; forts and camps challenge armed strangers they distrust
stormcloak  = 0.6
dawnguard   = 0.4
vigilant    = 0.4

; challenge armed strangers rather than hunting them (law enforcement, orders, zealotry)
[lawful]
imperial   = 1
stormcloak = 1
thalmor    = 1
dawnguard  = 1
vigilant   = 1

; offers a toll before it attacks
[parley]
bandit = 1

; bolder in the dark
[nocturnal]
vampire = 1

; how much killing their people brands the player a murderer (default 1). Killing Thalmor is not murder to most Nords.
[murder_weight]
thalmor = 0.3

[tiers]
hostile    = -1000
unfriendly = -300
friendly   = 300
allied     = 1000

[deeds]
goodwill_max          = 2000
kill_base             = 40      ; goodwill lost with a faction for each of its people killed (+ per level, + veteran)
kill_per_level        = 1.2
kill_veteran          = 25
kill_provoked_mult    = 0.35    ; they attacked first
ally_share            = 0.5     ; allies of the victims take it half as hard
friend_share          = 0.25
enemy_share           = 0.25    ; the victims' enemies are pleased by a quarter
unseen_mult           = 0.15    ; nobody saw it
discover_chance       = 0.4     ; a patrol finds the bodies later
discover_mult         = 0.6
discover_min_hours    = 6
discover_max_hours    = 36
help_base             = 14      ; killing a foe of a squad that was watching
help_per_level        = 0.5
daily_gain_cap        = 150     ; goodwill cannot be farmed
trade_per_100_gold    = 1.5
attack_goodwill       = 8
notoriety_per_severity = 0.8

[memory]                         ; what a squad itself holds against / owes the player
attack         = -250
kill           = -180
help           = 150
toll           = 120
half_life_days = 20

[decay]                          ; bad deeds are remembered longer than good ones
goodwill_positive_half_life_days = 40
goodwill_negative_half_life_days = 100
notoriety_half_life_days         = 60

[disguise]
bonus     = 350                  ; wearing their colours (full set)
suspicion = 250                  ; wearing their enemy's colours

[predators]
advantage_floor = 0.7            ; squad power / player power below this: they will not risk it
advantage_full  = 2.0            ; at or above this they are sure
hunger_bonus    = 0.15
wealth_bonus    = 0.2
night_bonus     = 0.25
fear_penalty    = 0.25           ; a notorious killer is not worth the risk
parley_from     = 0.35
attack_at       = 0.6
ambush_at       = 0.85

[meeting]
notice_range    = 2200
greet_range     = 700
challenge_range = 1100
challenge_grace = 9              ; seconds a challenge is allowed to stand before it ends in blood
talk_cooldown   = 90             ; seconds after a conversation closes before another squad stops the player to talk (attacks are not held back)
territory_radius = 2500

[crime]
murder_bounty = 650        ; crime gold a hold adds for killing its own soldiers without cause (guards then hunt the player there)

[toll]
base       = 40
per_level  = 6
pass_hours = 12

; ============================================================================================================
; Rules: because the player is X, faction Y regards them better or worse.
; when = flag & !flag & race:a,b & level>=N & notoriety>=N & bounty>=N (crime gold in the squad's hold) & enforces
;        & disguise:<faction>>=0.5      flags: imperial stormcloak companions thieves brotherhood college dawnguard volkihar
;        blades greybeards vampire werewolf beast armed sneaking mounted incombat night
; ============================================================================================================

; ---- the Civil War: a sworn soldier is a friend to their side and a target to the other
[rule.legion_sworn]
label      = Sworn to the Imperial Legion
when       = imperial
imperial   = 650
stormcloak = -1300
thalmor    = 350
vigilant   = 200

[rule.stormcloak_sworn]
label      = Sworn to the Stormcloaks
when       = stormcloak
stormcloak = 650
imperial   = -1300
thalmor    = -500

[rule.blades]
